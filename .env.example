# ============================================================================
# Copy to .env and fill in.  NEVER commit .env — it holds live trading creds.
# ============================================================================

# --- Breeze (ICICI Direct) credentials -------------------------------------
# Register an app at https://api.icicidirect.com to get these.
BREEZE_API_KEY=
BREEZE_API_SECRET=

# Session token expires DAILY. Get a fresh one each morning from:
#   https://api.icicidirect.com/apiuser/login?api_key=<url-encoded BREEZE_API_KEY>
# Leave blank here and paste it into the dashboard instead (preferred).
BREEZE_SESSION_TOKEN=

# --- Execution mode ---------------------------------------------------------
# paper = simulated fills against live prices (no real orders, no static IP needed)
# live  = real orders through Breeze (REQUIRES a registered static IP)
TRADING_MODE=paper

# Hard safety interlock. Live orders are refused unless this is exactly "I_UNDERSTAND_THE_RISK".
# Keep it unset until you have reviewed a full paper-trading track record.
LIVE_TRADING_CONFIRMATION=

# --- Capital & risk ---------------------------------------------------------
STARTING_CAPITAL=100000          # paper-trading starting balance (INR)
RISK_PER_TRADE_PCT=1.0           # % of equity risked per trade (stop distance basis)
MAX_DAILY_LOSS_PCT=3.0           # halt trading for the day past this drawdown
MAX_OPEN_POSITIONS=5
MAX_POSITION_PCT=20.0            # cap any single position at % of equity

# --- Stoploss / target (ATR multiples) --------------------------------------
ATR_STOP_MULTIPLIER=1.5
ATR_TARGET_MULTIPLIER=2.5
USE_TRAILING_STOP=true
TRAIL_ATR_MULTIPLIER=1.5

# --- Signal thresholds ------------------------------------------------------
SIGNAL_ENTRY_THRESHOLD=0.35      # |composite score| needed to open a position
SIGNAL_EXIT_THRESHOLD=0.15       # score decay that closes an open position

# --- Universe & timing ------------------------------------------------------
# Comma-separated Breeze stock codes (NOT NSE tickers — see docs/breeze-codes.md)
EQUITY_UNIVERSE=RELIND,TCS,INFTEC,HDFBAN,ICIBAN
BENCHMARK_CODE=NIFTY             # used for the market-regime filter
CANDLE_INTERVAL=5minute
INTRADAY_SQUAREOFF_TIME=15:10    # IST; all intraday positions force-closed at this time

# --- Costs (used by paper broker & backtester) ------------------------------
BROKERAGE_PCT=0.03               # ICICI Direct i-Secure/prepaid varies — set yours
SLIPPAGE_PCT=0.05                # modelled slippage per side

# --- Infrastructure ---------------------------------------------------------
DATABASE_PATH=data/market.duckdb
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
